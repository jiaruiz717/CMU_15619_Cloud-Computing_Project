    {
      "text": "import java.util.Locale\n\nobject countCommonTags {\n  def count(left:Array[String], right:Array[String]) : Int = {\n    var l: String = \"a\";\n    val lower_left = left.map(x=>x.toLowerCase(Locale.ENGLISH))\n    val lower_right = right.map(x=>x.toLowerCase(Locale.ENGLISH))\n    \n    val intersection_list = lower_left.toSet.intersect(lower_right.toSet) // [a,a,b] [b,b] = [b]\n    // val intersection_list = left.toSet.intersect(right.toSet)\n    \n    val left_counter = lower_left.groupBy(identity).mapValues(_.size) // {a:2, b:1}\n    val right_counter = lower_right.groupBy(identity).mapValues(_.size)  // {b:2}\n    // val left_counter = left.groupBy(identity).mapValues(_.size) // {a:2, b:1}\n    // val right_counter = right.groupBy(identity).mapValues(_.size)  // {b:2}\n    var total_sum:Int = 0;\n    for( common <- intersection_list ){ // b\n         total_sum += left_counter(common) + right_counter(common)\n      }\n     total_sum\n    // intersection_list.size\n}\n}\n\nval tagUDF = udf((left:Array[String], right:Array[String]) => countCommonTags.count(left, right))",
      "user": "anonymous",
      "dateUpdated": "2022-03-22T21:18:22+0000",
      "progress": 0,
