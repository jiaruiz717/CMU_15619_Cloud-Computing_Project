      "text": "val df2 = df.filter(df(\"id\").isNotNull || df(\"id_str\").isNotNull)\nval df3 = df2.filter($\"user.id\".isNotNull ||$\"user.id_str\".isNotNull )\nval df4 = df3.filter(size($\"entities.hashtags\") =!= 0 && $\"entities.hashtags\".isNotNull)\nval df5 = df4.filter(length($\"text\") =!= 0 && $\"text\".isNotNull)\nval df6 = df5.filter($\"created_at\".isNotNull)\nval df7 = df6.filter($\"lang\".isin(langList:_*))",
