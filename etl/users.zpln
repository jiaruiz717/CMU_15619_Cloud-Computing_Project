      "text": "val df8 = df7.withColumn(\"id\", when(col(\"id_str\").isNotNull, col(\"id_str\").cast(LongType)).otherwise(col(\"id\")))\n  .withColumn(\"id_str\", when(col(\"id\").isNotNull, col(\"id\").cast(StringType)).otherwise(col(\"id_str\")))\n  .withColumn(\"user_id\", when(col(\"user.id_str\").isNotNull, col(\"user.id_str\").cast(LongType)).otherwise(col(\"user.id\")))\n  .withColumn(\"user_id_str\", when(col(\"user.id\").isNotNull, col(\"user.id\").cast(StringType)).otherwise(col(\"user.id_str\")))\n  \nval df9 = df8.dropDuplicates(\"id_str\")",
