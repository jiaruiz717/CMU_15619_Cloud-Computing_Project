    {
      "text": "val array: Array[String] = Array(\"A\", \"a\", \"b\", \"BS\")\nval popular_array: Array[String] = Array(\"A\", \"Bs\", \"c\").map(v => v.toLowerCase())\nval common = common_hashtag(array, popular_array)\nval result_test = exclude_popular(array, popular_array)",
