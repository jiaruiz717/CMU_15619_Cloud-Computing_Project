    {
      "text": "val test_hashtag_df = spark.sql(\n    \"\"\"\n    SELECT hashtag_list\n    FROM origin\n    WHERE user_id = 774926515\n    \"\"\")\ntest_hashtag_df.printSchema()\ntest_hashtag_df.show()\n\nval test_hashtag_rdd = test_hashtag_df.rdd\nvar test_array: Array[String] = Array()\nfor(row <- test_hashtag_rdd.collect){\n    // test_array = test_array ++ row.getList(0)\n    // println(row.getList(0))\n    val size = row.getList(0).size()\n    for(i <- 0 to size-1){\n        test_array :+= row.getList(0).get(i)\n    }\n}\n\ntest_array.foreach(println)\n",
