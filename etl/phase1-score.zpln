            "data": "+--------------------+\n|        hashtag_list|\n+--------------------+\n|[Cloud, Computing...|\n|[cloud, cOmputing...|\n+--------------------+\n\n\u001b[1m\u001b[34msmall_user_hashtag_list_df\u001b[0m: \u001b[1m\u001b[32morg.apache.spark.sql.DataFrame\u001b[0m = [hashtag_list: array<string>]\n"
          }
