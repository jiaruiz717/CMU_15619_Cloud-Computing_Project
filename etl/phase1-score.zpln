    {
      "text": "import scala.math._\nval interaction_result = interaction_agg_pair_join.map(f =>{\n    val user_pair: String = f.getAs[String](0)\n    val user_1: Long = user_pair.split(\"\\t\")(0).toLong\n    val user_2: Long = user_pair.split(\"\\t\")(1).toLong\n    val reply_count: Long = f.getAs[Long](1)\n    val retweet_count: Long = f.getAs[Long](2)\n    val interaction_score = Math.log(1 + 2*reply_count + retweet_count)\n    (user_1, user_2, interaction_score)\n})\ninteraction_result.show()",
