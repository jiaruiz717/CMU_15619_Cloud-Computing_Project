    },
    {
      "text": "def get_hashtag_array(user: Long): Array[String]={\n    val hashtag_list_df = spark.sql(s\"select hashtag_list from origin where user_id = $user\")\n    var hashtag_array: Array[String] = Array()\n    for(row <- hashtag_list_df.collect){\n        val size = row.getList(0).size()\n        for(i <- 0 to size-1){\n            hashtag_array :+= row.getList(0).get(i)\n        }\n    }\n    return hashtag_array\n}",
      "user": "anonymous",
      "dateUpdated": "2022-03-18T11:53:03+0000",
      "progress": 0,
      "config": {
        "tableHide": true,
