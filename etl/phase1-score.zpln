            "type": "TEXT",
            "data": "\u001b[1m\u001b[34mcommon_hashtag\u001b[0m: \u001b[1m\u001b[32m(small: Array[String], big: Array[String])Long\u001b[0m\n"
          }
        ]
      },
      "apps": [],
