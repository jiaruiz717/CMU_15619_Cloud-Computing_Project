    },
    {
      "text": "val final_result = spark.sql(\r\n      \"\"\"\r\n    SELECT interaction._1 AS user1, interaction._2 AS user2, interaction._3 AS interaction_score, hashtag.score AS hashtag_score\r\n    FROM interaction_result AS interaction INNER JOIN hashtag_result AS hashtag\r\n    ON interaction._1 = hashtag.small AND interaction._2 = hashtag.big\r\n    \"\"\")\r\nfinal_result.show()",
      "user": "anonymous",
      "dateUpdated": "2022-03-18T11:53:03+0000",
      "progress": 0,
