      "status": "READY",
      "$$hashKey": "object:14597"
    },
    {
      "text": "def common_hashtag(small: Array[String], big: Array[String]): Long={\r\n    val small_temp = small.map(v => v.toLowerCase()).map((_,1)).groupBy(_._1).map(x=>(x._1,x._2.size))\r\n    val big_temp = big.map(v => v.toLowerCase()).map((_,1)).groupBy(_._1).map(x=>(x._1,x._2.size))\r\n    val small_df = small_temp.toSeq.toDF(\"tag\", \"count\")\r\n    val big_df = big_temp.toSeq.toDF(\"tag\", \"count\")\r\n    small_df.createOrReplaceTempView(\"small\")\r\n    big_df.createOrReplaceTempView(\"big\")\r\n    val join_df = spark.sql(\r\n        \"\"\"\r\n        SELECT small.tag AS tag, small.count+big.count AS count\r\n        FROM small INNER JOIN big\r\n        ON small.tag = big.tag\r\n        \"\"\")\r\n    return join_df.agg(sum(\"count\")).first.getLong(0)\r\n  }",
      "user": "anonymous",
      "dateUpdated": "2022-03-18T11:53:02+0000",
      "progress": 0,
      "config": {
        "tableHide": true,
        "editorSetting": {
          "language": "scala",
          "editOnDblClick": false,
