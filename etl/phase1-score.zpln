    {
      "text": "def exclude_popular(array: Array[String], popular_array: Array[String]): Array[String] = {\r\n    var result: Array[String] = Array()\r\n    val array_to_lowercase = array.map(v => v.toLowerCase())\r\n    array_to_lowercase.foreach(element => {\r\n      if (!popular_array.contains(element)) {\r\n        result :+= element\r\n      }\r\n    })\r\n    return result\r\n  }",
      "user": "anonymous",
      "dateUpdated": "2022-03-18T11:53:02+0000",
      "progress": 0,
      "config": {
