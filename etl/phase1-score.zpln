      "status": "READY",
      "$$hashKey": "object:14604"
    },
    {
      "text": "val distinct_user_pair_rdd = distinct_user_pair_df.rdd\nval hashtag_score_rdd = distinct_user_pair_rdd.take(distinct_user_pair_rdd.count().toInt).map(f => {\n    val small_user: Long = f.split(\"\\t\")(0).toLong\n    val big_user: Long = f.split(\"\\t\")(1).toLong\n    val small_user_hashtag_array: Array[String] = get_hashtag_array(small_user)\n    val big_user_hashtag_array: Array[String] = get_hashtag_array(big_user)\n    val small_user_hashtag_array_exclude_popular = exclude_popular(small_user_hashtag_array, excluded_hashtag_array) \n    val big_user_hashtag_array_exclude_popular = exclude_popular(big_user_hashtag_array, excluded_hashtag_array)  \n    val num_of_common_hashtag = common_hashtag(small_user_hashtag_array_exclude_popular, big_user_hashtag_array_exclude_popular)\n    val hashtag_score = if (small_user == big_user || num_of_common_hashtag <= 10) 1 else 1+Math.log(1+num_of_common_hashtag-10)\n    (small_user,big_user,hashtag_score)\n})\nval hashtag_result = hashtag_score_rdd.toSeq.toDF(\"small\", \"big\", \"score\")\nhashtag_result.show()",
      "user": "anonymous",
      "dateUpdated": "2022-03-18T11:53:03+0000",
