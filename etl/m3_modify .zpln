    {
      "text": "val interaction_agg_pair = interaction_agg.map(f => {\n    val user_pair: String = f.getAs[String](0)\n    val first_user: Long = user_pair.split(\"\\t\")(0).toLong\n    val second_user: Long = user_pair.split(\"\\t\")(1).toLong\n    val small_user: Long = if(first_user < second_user) first_user else second_user\n    val big_user: Long= if(small_user == first_user) second_user else first_user\n    val join_user_pair: String = s\"${small_user}\\t${big_user}\"\n    val reply_count: Long = f.getAs[Long](1)\n    val retweet_count: Long = f.getAs[Long](2)\n    (join_user_pair, reply_count, retweet_count)\n})\n// interaction_agg_pair.show()",
      "user": "anonymous",
      "dateUpdated": "2022-03-20T22:27:31+0000",
      "config": {
        "editorSetting": {
          "language": "scala",
          "editOnDblClick": false,
