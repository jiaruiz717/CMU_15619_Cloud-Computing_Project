    {
      "text": "val interaction_agg_pair_join = spark.sql(\n    \"\"\"\n    SELECT _1 AS user_pair, SUM(_2) AS reply_count, SUM(_3) AS retweet_count\n    FROM interaction_agg_pair\n    GROUP BY user_pair\n    ORDER BY reply_count+retweet_count DESC\n    \"\"\")\n// interaction_agg_pair_join.show()",
      "user": "anonymous",
      "dateUpdated": "2022-03-20T22:27:32+0000",
      "config": {
        "editorSetting": {
          "language": "scala",
