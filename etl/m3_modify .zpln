    },
    {
      "text": "val interaction_agg = spark.sql(\n    \"\"\"\n    SELECT \n    CASE WHEN reply.user_pair IS NULL THEN retweet.user_pair\n    ELSE reply.user_pair\n    END AS user_pair,\n    CASE WHEN reply_count IS NULL THEN 0\n    ELSE reply_count\n    END AS reply_count,\n    CASE WHEN retweet_count IS NULL THEN 0\n    ELSE retweet_count\n    END AS retweet_count\n    FROM interaction_retweet_agg AS retweet\n    FULL OUTER JOIN interaction_reply_agg AS reply\n    ON retweet.user_pair = reply.user_pair\n    \"\"\")\n// interaction_agg.show()",
      "user": "anonymous",
      "dateUpdated": "2022-03-20T22:27:31+0000",
      "config": {
