            "data": "\u001b[1m\u001b[34minteraction_agg_pair_join\u001b[0m: \u001b[1m\u001b[32morg.apache.spark.sql.DataFrame\u001b[0m = [user_pair: string, reply_count: bigint ... 1 more field]\n"
          }
        ]
      },
